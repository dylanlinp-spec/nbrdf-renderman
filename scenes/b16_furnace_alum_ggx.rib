##RenderMan RIB
version 3.03

# Track B LOW-SPP variant, GGX-only. See b16_furnace_alum_mixture.rib's
# header for why 16 spp (not 512) is the right setting for this track.
# This is the one expected to look visibly worse (per Sec 3.2: alum-bronze
# is darkest near the mirror direction, which is exactly where a narrow
# GGX-only lobe concentrates its samples -- an anti-correlated proxy).
# Diff with:
#   python furnace_check.py --exr b16_furnace_alum_ggx.exr --csv albedo_alum.csv

Display "b16_furnace_alum_ggx.exr" "file" "rgba"
Format 512 512 1
PixelFilter "box" 1 1

Projection "orthographic"
ScreenWindow -1.2 1.2 -1.2 1.2
Clipping 0.1 1000
Translate 0 0 5

Hider "raytrace" "int minsamples" [16] "int maxsamples" [16]

WorldBegin

    Light "PxrDomeLight" "furnace"
        "float intensity" [1.0]
        "float exposure" [0]
        "color lightColor" [1.0 1.0 1.0]

    # samplingMode 2 = GGX-around-mirror ONLY.
    Bxdf "NBrdf" "furnace_material"
        "string weightsPath" ["C:/NBrdfBuild/nbrdf_weights.bin"]
        "int samplingMode" [2]
    Sphere 1 -1 1 360

WorldEnd
