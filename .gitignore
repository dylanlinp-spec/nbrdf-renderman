# Built from the GitHub "VisualStudio" and "Python" templates
# (https://github.com/github/gitignore), trimmed to what this project creates.
# Rule of thumb: ignore anything a script can regenerate, anything large,
# and anything secret.

# --- MSVC build outputs (regenerated by scripts/04 and 05) ---
*.obj
*.dll
*.exp
*.lib
*.ilk
*.pdb
*.exe
run_with_msvc.bat

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Raw data (download it yourself; see data/README.md) ---
data/merl/
*.binary

# --- Generated results (your own reproduction run) ---
results/reproduced/
*.exr
*.npy

# --- Secrets: never commit credentials or licence files ---
.env
*.env
pixar.license
*.lic

# --- Editors and operating systems ---
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
